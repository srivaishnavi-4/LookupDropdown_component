
{
  "customerLookup": {
    "entity": "customer",
    "dataSource": "/data/customers.json",

    "selection": {
      "type": "lookup",
      "label": "Customer",
      "placeholder": "Search customer...",
      "selectedValue": "name",
      "valueField": "id",
      "icon": "search",
      "required": true,
      "disabled": false,
      "readonly": false,
      "clearable": true
    },

    "search": {
      "enabled": true,
      "fields": ["name", "id", "email"],
      "caseSensitive": false,
      "trimSpaces": true
    },

    "dropdown": {
      "primaryField": "name",
      "secondaryFields": [
        {
          "field": "id",
          "label": "Customer ID"
        },
        {
          "field": "customerType",
          "label": "Type"
        },
        {
          "field": "status",
          "label": "Status",
          "format": "status"
        }
      ],
      "filter": {
        "enabled": false,
        "field": "status",
        "operator": "equals",
        "value": "Active"
      },
      "sort": {
        "field": "name",
        "direction": "asc"
      },
      "pageSize": 10,
      "autoSelectSingle": false
    },

    "card": {
      "visible": true,
      "columns": 3,
      "emptyValue": "—",
      "missingValueBehavior": "fallback",
      "fields": [
        {
          "field": "address",
          "label": "Address",
          "format": "text",
          "visible": true
        },
        {
          "field": "customerType",
          "label": "Customer type",
          "format": "text",
          "visible": true
        },
        {
          "field": "status",
          "label": "Status",
          "format": "status",
          "visible": true
        }
      ]
    },

    "behavior": {
      "disableInactive": false,
      "showNoResults": true,
      "showNoOptions": true,
      "retainSelectionOnError": true,
      "loadDetailsOnSelection": true
    }
  },

  "billingAccountDropdown": {
    "entity": "billingAccount",
    "dataSource": "/data/billingAccounts.json",

    "selection": {
      "type": "dropdown",
      "label": "Billing Account",
      "placeholder": "Select billing account...",
      "selectedValue": "accountName",
      "valueField": "id",
      "icon": "chevron-down",
      "required": true,
      "disabled": false,
      "readonly": false,
      "clearable": true
    },

    "search": {
      "enabled": false,
      "fields": ["accountName", "accountNumber"]
    },

    "dropdown": {
      "primaryField": "accountName",
      "secondaryFields": [
        {
          "field": "accountNumber",
          "label": "Account Number"
        },
        {
          "field": "billingType",
          "label": "Billing Type"
        },
        {
          "field": "status",
          "label": "Status",
          "format": "status"
        }
      ],
      "filter": {
        "enabled": false,
        "field": "status",
        "operator": "equals",
        "value": "Active"
      },
      "sort": {
        "field": "accountName",
        "direction": "asc"
      },
      "pageSize": 10,
      "autoSelectSingle": false
    },

    "card": {
      "visible": true,
      "columns": 3,
      "emptyValue": "—",
      "missingValueBehavior": "fallback",
      "fields": [
        {
          "field": "accountNumber",
          "label": "Account number",
          "format": "text",
          "visible": true
        },
        {
          "field": "billingType",
          "label": "Billing type",
          "format": "text",
          "visible": true
        },
        {
          "field": "status",
          "label": "Status",
          "format": "status",
          "visible": true
        }
      ]
    },

    "dependency": {
      "enabled": true,
      "parentField": "customerId",
      "parentEntity": "customerLookup",
      "parentValueField": "id",
      "clearOnParentChange": true
    },

    "behavior": {
      "disableInactive": false,
      "showNoResults": true,
      "showNoOptions": true,
      "retainSelectionOnError": true,
      "loadDetailsOnSelection": true
    }
  },

  "contactLookup": {
