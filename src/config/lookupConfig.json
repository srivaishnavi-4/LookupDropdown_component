    },

    "card": {
      "visible": true,
      "columns": 2,
      "emptyValue": "—",
      "missingValueBehavior": "fallback",
      "fields": [
        {
          "field": "email",
          "label": "Email",
          "format": "text",
          "visible": true
        },
        {
          "field": "phone",
          "label": "Phone",
          "format": "text",
          "visible": true
        },
        {
          "field": "title",
          "label": "Title",
